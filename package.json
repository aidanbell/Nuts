    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.14.3",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.10.2"
  }
